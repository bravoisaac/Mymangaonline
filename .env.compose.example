# Copia este archivo como .env.compose y reemplaza el dominio antes de desplegar.
COMPOSE_PROJECT_NAME=mymangaonline
IMAGE_TAG=1.0.0
API_IMAGE_NAME=mymangaonline-api
WEB_IMAGE_NAME=mymangaonline-web

# Mantener 127.0.0.1 cuando un proxy TLS (Caddy, Traefik, Nginx o el proveedor) publique el sitio.
# Usar 0.0.0.0 solo si se entiende que el puerto quedara accesible desde la red.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
WEB_ORIGIN=https://manga.example.com

# La API no publica puertos y solo confia en proxies de redes privadas/loopback.
TRUST_PROXY=loopback, linklocal, uniquelocal

MANGADEX_ENABLED=true
COMICK_ENABLED=true
TRANSLATION_ENABLED=false
